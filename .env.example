# Copy to .env.local for local development. Never commit .env.local.
# Development/test fall back to localhost; production builds require this value.
# Use the real public origin in Vercel production, and the preview origin in previews.
# This value is public metadata. Never give a secret a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Provider credentials will be introduced with their integration tasks.
# Spotify and weather configuration are deferred to v1.1.
